📄 build-ghcr.yml
yaml
name: Build & Push Docker Image to GHCR

on:
  push:
    branches: ["main"]
    tags: ["v*"]
  workflow_dispatch:

env:
  IMAGE_NAME: k3d-platform       # cambia esto por tu nombre de imagen

jobs:
  build:
    runs-on: ubuntu-latest

    permissions:
      contents: read
      packages: write
      id-token: write             # requerido para firma (opcional)

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up QEMU
        uses: docker/setup-qemu-action@v3

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Extract metadata (tags, labels)
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ghcr.io/${{ github.repository_owner }}/$IMAGE_NAME

      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: .
          file: ./Dockerfile
          platforms: linux/amd64   # agrega linux/arm64 si quieres multiarquitectura
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}

      # OPCIONAL — firma de la imagen con Sigstore (cosign)
      - name: Sign image
        uses: sigstore/cosign-installer@v3
      - run: |
          cosign sign \
            --yes \
            ghcr.io/${{ github.repository_owner }}/$IMAGE_NAME@${{ steps.meta.outputs.digest }}

