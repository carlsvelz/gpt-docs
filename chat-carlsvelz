#!/bin/bash
set -e

echo "=================================================="
echo "🔥 K3D-LAKEHOUSE — Bootstrap del clúster"
echo "=================================================="

export PATH=/home/vscode/bin:$PATH
export DOCKER_HOST=unix:///run/user/1000/docker.sock

echo ">> Verificando Docker rootless..."
docker info >/dev/null 2>&1 || { echo "❌ Docker rootless no está corriendo"; exit 1; }

echo ">> Eliminando cluster previo si existe..."
k3d cluster delete lakehouse || true

echo ">> Creando cluster k3d-lakehouse..."

k3d cluster create lakehouse \
    --servers 1 \
    --agents 1 \
    --port "8888:8888@loadbalancer" \
    --timeout 120s

echo ">> Esperando que el API server responda..."
sleep 5
kubectl wait --for=condition=Ready pods --all -A --timeout=60s || true

# -----------------------------------------------------
# Namespaces
# -----------------------------------------------------

echo ">> Creando namespaces..."

kubectl create namespace lakehouse-system || true
kubectl create namespace lakehouse-user || true

# -----------------------------------------------------
# RBAC restrictivo para el usuario
# -----------------------------------------------------

echo ">> Configurando RBAC restrictivo..."

cat <<EOF | kubectl apply -f -
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  namespace: lakehouse-user
  name: lakehouse-user-role
rules:
  - apiGroups: [""]
    resources: ["pods", "services", "endpoints", "configmaps"]
    verbs: ["get", "list", "watch", "create", "update", "delete"]

  - apiGroups: ["apps"]
    resources: ["deployments", "statefulsets"]
    verbs: ["get", "list", "watch", "create", "update", "delete"]

  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["create"]
EOF

# RoleBinding para vincular el ServiceAccount default al rol del usuario
cat <<EOF | kubectl apply -f -
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: lakehouse-user-binding
  namespace: lakehouse-user
subjects:
  - kind: ServiceAccount
    name: default
    namespace: lakehouse-user
roleRef:
  kind: Role
  name: lakehouse-user-role
  apiGroup: rbac.authorization.k8s.io
EOF

# -----------------------------------------------------
# Seguridad extra — impedir que users vean el cluster
# -----------------------------------------------------
echo ">> Prohibiendo acceso a cluster-wide objects..."

cat <<EOF | kubectl apply -f -
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: deny-everything
rules: []
EOF

cat <<EOF | kubectl apply -f -
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: deny-users
subjects:
  - kind: ServiceAccount
    name: default
    namespace: lakehouse-user
roleRef:
  kind: ClusterRole
  name: deny-everything
  apiGroup: rbac.authorization.k8s.io
EOF

# Esto bloquea:
# - kubectl get pods -A
# - kubectl describe nodes
# - kubectl get secrets -A
# - kubectl get deployments -n kube-system

# -----------------------------------------------------
# Mensaje final
# -----------------------------------------------------

echo "=================================================="
echo "🎉 Cluster K3D-LAKEHOUSE listo"
echo "=================================================="
echo "Namespaces:"
echo "  - lakehouse-system (oculto al usuario)"
echo "  - lakehouse-user   (espacio del usuario)"
echo ""
echo "RBAC:"
echo "  ✔ El usuario solo puede ver/crear en lakehouse-user"
echo "  ✔ No puede leer nada del cluster ni kube-system"
echo ""
echo "Probar:"
echo "  kubectl get pods -n lakehouse-user"
echo "  kubectl get pods -A   # -> DENIED"
echo "=================================================="

