dockerfile
# Imagen base recomendada por GitHub Codespaces
FROM mcr.microsoft.com/devcontainers/base:ubuntu

SHELL ["/bin/bash", "-c"]

# -------------------------------------------------------------------
#    INSTALAR PAQUETES BÁSICOS
# -------------------------------------------------------------------
RUN apt-get update && \
    apt-get install -y \
        curl \
        wget \
        iproute2 \
        iputils-ping \
        sudo \
        gnupg \
        ca-certificates \
        bash-completion \
        nano vim \
        jq \
        htop \
        fuse3 \
        socat \
        uidmap \
        dbus-user-session && \
    apt-get clean

# -------------------------------------------------------------------
#   INSTALAR DOCKER ROOTLESS (LO QUE SOPORTA CODESPACES)
# -------------------------------------------------------------------
RUN curl -fsSL https://get.docker.com/rootless | sh && \
    echo "export PATH=\$HOME/bin:\$PATH" >> /home/vscode/.bashrc

ENV PATH="/home/vscode/bin:${PATH}"
ENV DOCKER_HOST="unix:///run/user/1000/docker.sock"

# -------------------------------------------------------------------
#   INSTALAR KUBECTL
# -------------------------------------------------------------------
RUN curl -LO "https://dl.k8s.io/release/$(curl -Ls https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" && \
    install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl && \
    rm kubectl

# -------------------------------------------------------------------
#   INSTALAR K3D (funciona perfecto con Docker rootless)
# -------------------------------------------------------------------
RUN curl -s https://raw.githubusercontent.com/k3d-io/k3d/main/install.sh | bash

# -------------------------------------------------------------------
#   INSTALAR HELM
# -------------------------------------------------------------------
RUN curl https://raw.githubusercontent.com/helm/helm/master/scripts/get-helm-3 | bash

# -------------------------------------------------------------------
#   INSTALAR K9S (opcional pero muy útil)
# -------------------------------------------------------------------
RUN curl -LO https://github.com/derailed/k9s/releases/latest/download/k9s_Linux_amd64.tar.gz && \
    tar -xvf k9s_Linux_amd64.tar.gz && \
    mv k9s /usr/local/bin/k9s && \
    rm k9s_Linux_amd64.tar.gz

# -------------------------------------------------------------------
#   HABILITAR COMPLETIONS
# -------------------------------------------------------------------
RUN echo "source <(kubectl completion bash)" >> /home/vscode/.bashrc && \
    echo "source <(helm completion bash)" >> /home/vscode/.bashrc && \
    echo "complete -o default -F __start_kubectl k" >> /home/vscode/.bashrc

# Permisos para el user "vscode" de Codespaces
USER vscode

WORKDIR /workspaces

